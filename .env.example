# ---------------------------------------------------------------------------
# FactoryMind environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# Never commit a filled-in .env - it is git-ignored.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=FactoryMind
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ---
# PostgreSQL is the production target (see docker-compose.yml).
# For local development without a Postgres server, use the SQLite fallback:
#   DATABASE_URL=sqlite:///./factorymind.db
DATABASE_URL=postgresql+psycopg2://factorymind:factorymind@localhost:5432/factorymind
DB_ECHO=false

# --- Paths (relative paths resolve against the repository root) ---
DATASETS_DIR=./datasets
MODELS_DIR=./models
STORAGE_DIR=./storage

# --- LLM (optional) ---
# Without a key FactoryMind runs every agent on its deterministic rule-based
# fallback and labels the output accordingly. Never hardcode keys here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.0

# --- Embeddings for RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# --- ML runtime ---
ANOMALY_THRESHOLD=0.62
RISK_HIGH_THRESHOLD=0.6
RISK_CRITICAL_THRESHOLD=0.82
TORCH_DEVICE=cpu
RANDOM_SEED=42

# --- Computer vision ---
VISION_IMAGE_SIZE=256
VISION_PATCH_SIZE=16
VISION_THRESHOLD=0.5
